{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "ai-orbit-frontend": {
      "root": "frontend/",
      "framework": "vite"
    },
    "ai-orbit-backend": {
      "root": "backend/",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "ai-orbit-backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "ai-orbit-frontend"
      }
    }
  ]
}
